<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>NumberConversions</AssemblyName>
    <RootNamespace>NumberConversions.Plugin</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <Authors>Ebenezer Illango</Authors>
    <Company>Paratext Translation Tools</Company>
    <Product>Number Conversions Paratext Plugin</Product>
    <Description>Paratext 9.5 Plugin for Tamil Scripture Number Conversions</Description>
    <ParatextInstallDir Condition="'$(ParatextInstallDir)' == ''">D:\Transdata\Paratext 9</ParatextInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NumberConversions.Core\NumberConversions.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PluginInterfaces">
      <HintPath>$(ParatextInstallDir)\PluginInterfaces.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="CorePluginInterfaces">
      <HintPath>$(ParatextInstallDir)\CorePluginInterfaces.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Create the .ptxplg file directly from the output assembly -->
  <Target Name="CreatePtxplg" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(TargetDir)$(TargetName).ptxplg" />
    <Message Importance="high" Text="Generated Paratext Plugin: $(TargetDir)$(TargetName).ptxplg" />
  </Target>

</Project>

# Auto-detect text files and perform LF normalization
* text=auto

# C# source files
*.cs text diff=csharp eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf

# Markdown and documentation
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Paratext & Scripture files (USFM / SFM) - always UTF-8
*.usfm text eol=crlf
*.sfm text eol=crlf

# Binary files
*.dll binary
*.ptxplg binary
*.exe binary
*.pdb binary
*.ico binary
*.png binary
